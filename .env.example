TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Optional: use OpenJEV, a free community gateway to the same Jev model.
# Set JEV_PROVIDER=openjev to force OpenJEV, or leave TYPESAFE_API_KEY empty
# and set OPENJEV_API_KEY to use it automatically.
# OPENJEV_API_KEY=
# JEV_PROVIDER=openjev
# OPENJEV_MODEL=openjev
# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
